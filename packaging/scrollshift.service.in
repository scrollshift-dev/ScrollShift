[Unit]
Description=ScrollShift intent-aware mouse wheel acceleration
Documentation=https://scrollshift.github.io/docs/
After=systemd-udevd.service

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/scrollshift daemon --config /etc/scrollshift/config.conf
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=2s
TimeoutStopSec=2s

[Install]
WantedBy=multi-user.target
